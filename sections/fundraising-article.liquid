<script>
document.addEventListener('DOMContentLoaded', function() {
    const productAddContainers = document.querySelectorAll('.product-add');
    const containerSelected = document.querySelector('.container-products-selected');
    const containerTotal = document.querySelector('.container-total');
    const containerFundraising = document.querySelector('.container-fundraising');
    const checkoutButton = document.querySelector('.container-button');
    const shareButton = document.querySelector('.container-share-button');
    const tipOptions = document.querySelectorAll('.tip-option');
    const containerNumberTotalAmount = document.querySelector('.container-number-total-amount');
    const subscriptionOptions = document.querySelectorAll('.container-text-suscription');
    const containerProductsList = document.querySelector('.container-products');
    const btnPrev = document.querySelector('.carousel-prev');
    const btnNext = document.querySelector('.carousel-next');

    if (btnPrev && btnNext && containerProductsList) {
        btnPrev.addEventListener('click', function() {
            containerProductsList.scrollBy({ left: -270, behavior: 'smooth' });
        });
        btnNext.addEventListener('click', function() {
            containerProductsList.scrollBy({ left: 270, behavior: 'smooth' });
        });
    }
    
    let selectedProducts = {};
    let selectedTip = null;
    let isSubscription = false;
    const SELLING_PLAN_ID = 4473290888;
    
    // Configurar el One Time por defecto
    const defaultSubOption = document.querySelector('.container-text-suscription[data-type="one-time"]');
    if (defaultSubOption) defaultSubOption.classList.add('selected');

    subscriptionOptions.forEach(option => {
        option.addEventListener('click', function() {
            subscriptionOptions.forEach(opt => opt.classList.remove('selected'));
            this.classList.add('selected');
            isSubscription = this.dataset.type === 'subscription';
        });
    });

    tipOptions.forEach(tip => {
        tip.addEventListener('click', function() {
            if (selectedTip && selectedTip.element === this) {
                // Deseleccionar si ya estaba seleccionado
                this.classList.remove('selected');
                selectedTip = null;
            } else {
                // Quitar selección previa si existe
                if (selectedTip) {
                    selectedTip.element.classList.remove('selected');
                }
                this.classList.add('selected');
                selectedTip = {
                    id: this.dataset.id,
                    price: parseInt(this.dataset.price, 10),
                    element: this
                };
            }
            updateCartDisplay();
        });
    });
    
    productAddContainers.forEach(container => {
        const btnMinus = container.querySelector('.qty-minus');
        const btnPlus = container.querySelector('.qty-plus');
        const id = container.dataset.productId;
        const title = container.dataset.productTitle;
        const price = parseInt(container.dataset.productPrice, 10);
        const image = container.dataset.productImage;
        
        btnPlus.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (selectedProducts[id]) {
                selectedProducts[id].quantity += 1;
            } else {
                selectedProducts[id] = { id, title, price, image, quantity: 1 };
            }
            updateCartDisplay();
        });

        btnMinus.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (selectedProducts[id] && selectedProducts[id].quantity > 0) {
                selectedProducts[id].quantity -= 1;
                if (selectedProducts[id].quantity === 0) {
                    delete selectedProducts[id];
                }
                updateCartDisplay();
            }
        });
    });
    
    function updateCartDisplay() {
        containerSelected.innerHTML = '';
        let total = 0;
        
        Object.values(selectedProducts).forEach(product => {
            total += product.price * product.quantity;
            
            const itemElement = document.createElement('div');
            itemElement.className = 'selected-item';
            itemElement.innerHTML = `
                ${product.image ? `<img src="${product.image}" class="selected-item-thumb" alt="${product.title}">` : ''}
                <div class="selected-item-info">
                    <span>${product.title} (x${product.quantity})</span>
                </div>
                <button class="remove-item" data-id="${product.id}" aria-label="Quitar">&#10005;</button>
            `;
            containerSelected.appendChild(itemElement);
        });
        
        containerTotal.innerHTML = `<div>Total: ${formatMoney(total)}</div>`;
        if (containerFundraising) {
            containerFundraising.innerHTML = `${formatMoney(total * 0.075)} (7.5%) are going to funding`;
        }
        
        let tipAmount = selectedTip ? selectedTip.price : 0;
        let finalTotal = total + tipAmount;
        if (containerNumberTotalAmount) {
            containerNumberTotalAmount.textContent = formatMoney(finalTotal);
        }
        
        // Sincronizar los spans de cantidad en las tarjetas de productos
        document.querySelectorAll('.product-add').forEach(container => {
            const id = container.dataset.productId;
            const qtySpan = container.querySelector('.qty-value');
            if (selectedProducts[id]) {
                qtySpan.textContent = selectedProducts[id].quantity;
            } else {
                qtySpan.textContent = "0";
            }
        });
        
        document.querySelectorAll('.remove-item').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                delete selectedProducts[id];
                updateCartDisplay();
            });
        });
    }
    
    // Inicializar totales y cantidades en 0
    updateCartDisplay();
    
    function formatMoney(cents) {
        return '$' + (cents / 100).toFixed(2);
    }
    
    if (checkoutButton) {
        checkoutButton.addEventListener('click', function() {
            // 💡 Asegúrate de tener estas variables de Liquid disponibles antes de tu JS.
            // Si tu código JS está dentro de una etiqueta <script> en un archivo .liquid del blog,
            // puedes inyectar los metafields así (ajusta el nombre del metafield del porcentaje si es distinto):
            const idCampana = '{{ article.metafields.custom.owner_coffeefundme }}';
            const porcentajeCampana = '{{ article.metafields.custom.porcentaje }}'; // e.g. "15" para 15%

            const items = Object.values(selectedProducts).map(p => {
                let item = {
                    id: p.id,
                    quantity: p.quantity,
                    // 🚀 AQUÍ agregamos las propiedades ocultas que llegarán directas a nuestro Webhook
                    properties: {
                        '_campana_id': idCampana,
                        '_campana_porcentaje': porcentajeCampana
                    }
                };
                
                if (typeof isSubscription !== 'undefined' && isSubscription) {
                    item.selling_plan = SELLING_PLAN_ID;
                }
                return item;
            });

            if (typeof selectedTip !== 'undefined' && selectedTip && selectedTip.id) {
                items.push({
                    id: selectedTip.id,
                    quantity: 1
                    // Las propinas o donativos directos a la tienda no suelen contar para la campaña, 
                    // así que las dejamos sin "properties".
                });
            }
            
            if (items.length === 0) return;
            
            checkoutButton.textContent = 'Agregando...';
            
            const rootUrl = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';
            
            fetch(rootUrl + 'cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: items })
            })
            .then(response => response.json())
            .then(() => {
                return fetch(rootUrl + 'cart/update.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        attributes: {
                            'product_bundle': 'Yes'
                        }
                    })
                });
            })
            .then(() => {
                window.location.href = rootUrl + 'cart';
            })
            .catch((error) => {
                console.error('Error:', error);
                checkoutButton.textContent = 'Error';
            });
        });
    }

    if (shareButton) {
        shareButton.addEventListener('click', async function() {
            const shareData = {
                title: document.title,
                text: 'Check out this fundraising campaign!',
                url: window.location.href
            };

            if (navigator.share) {
                try {
                    await navigator.share(shareData);
                } catch (err) {
                    console.log('Error compartiendo:', err);
                }
            } else {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    const originalText = shareButton.textContent;
                    shareButton.textContent = 'Copied to clipboard!';
                    setTimeout(() => {
                        shareButton.textContent = originalText;
                    }, 2000);
                });
            }
        });
    }
});
</script>
<div id="campaign-progress-container">
  <h3>Progreso de la Campaña</h3>
  <p>Recaudado: $<span id="camp-current">0</span> / Meta: $<span id="camp-goal">0</span></p>
  <progress id="camp-bar" value="0" max="100"></progress>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // 1. Obtener el ID de la campaña desde el metafield de Shopify
  const idCampana = '{{ article.metafields.custom.owner_coffeefundme }}';
  
  if (!idCampana) return;

  // URL final generada por el Worker de Cloudflare para tu proyecto
  const workerUrl = `https://crowdfunding-backend.paulmontoya15.workers.dev/campaign/${idCampana}`;

  fetch(workerUrl)
    .then(response => {
      if (!response.ok) throw new Error("Campaña no encontrada");
      return response.json();
    })
    .then(data => {
      // data.current_amount y data.goal_amount vienen directamente sincronizados de Supabase
      const current = parseFloat(data.current_amount);
      const goal = parseFloat(data.goal_amount);
      const percent = goal > 0 ? (current / goal) * 100 : 0;

      // Actualizar el HTML
      document.getElementById('camp-current').textContent = current.toLocaleString();
      document.getElementById('camp-goal').textContent = goal.toLocaleString();
      document.getElementById('camp-bar').value = percent;
    })
    .catch(error => console.error("Error obteniendo el progreso:", error));
});
</script>

