        "type": "item",
        "name": "Item",
        "settings": [
            {
            "type": "blog",
            "id": "blog",
            "label": "Seleccionar blog"
            },
            {
            "type": "image_picker",
            "id": "image",
            "label": "Imagen"
            }
        ]
        }
    ],
    "max_blocks": 12,
    "presets": [
        {
        "name": "Fundraising"
        }
    ]
    }
{% endschema %}