<div class="main-container">
    <div class="container-title-blog">
        <h1 class="blog-title">{{ section.settings.title | upcase }}</h1>
        <div class="blog-description">{{ section.settings.description | upcase }}</div>
    </div>
    <div class="container-titles-blogs">
        {% for block in section.blocks %}
            <a href="#blog-{{ forloop.index }}" class="title-blog">{{ block.settings.blog.title | upcase }}</a>
        {% endfor %}
    </div>
    {% for blog in section.blocks %}
        <div class="title-container-blog" id="blog-{{ forloop.index }}">{{ blog.settings.blog.title  }}</div>
        <div class="container-blog ">
            {% for article in blog.settings.blog.articles %}
                <a class="card-article" href="{{ article.url }}">
                    <div class="image-article">
                        <img src="{{ article.image | img_url: 'master' }}" alt="{{ article.title }}">
                    </div>
                    <div class="content-article">
                        <div class="title-article">{{ article.metafields.custom.blog_text }}</div>
                        <div class="fundraising-article-content">
                            <div class="progress">
                                <div class="progress-bar">&nbsp;</div>
                            </div>
                            
                            <div class="progress-text">$2,230 RAISED</div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endfor %}
</div>

<style>
    .main-container{
        height: auto;
        width: 100vw;
        color: black;
        margin-top: 100px;
        margin-bottom: 100px;
        gap: 50px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        background: white;
        z-index: 2;
        position: relative;
    }
    .container-title-blog{
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
        width: 1300px;
    }
    .blog-title{
        font-size: 60px;
        font-weight: 400;
        color: black;
        text-align: center;
        margin: 0;
        width: 810px;
        text-align: left;
    }
    .blog-description{
        font-size: 28px;
        font-weight: 400;
        color: black;
        font-family: 'Modesto Text', sans-serif;
        color: rgb(179 176 176);
        width: 870px;
        text-align: left;
        width: 870px;
        line-height: 35px;
    }
    .container-titles-blogs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        column-gap: 60px;
        width: 1300px;
        row-gap: 40px;
    }

    @media (max-width: 1024px) {
        .container-titles-blogs {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .container-titles-blogs {
            grid-template-columns: 1fr;
        }
    }
    .title-blog{
        font-size: 16px;
        font-weight: 700;
        color: black;
        background-color: #FFD700;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        padding: 15px 60px;
        text-transform: uppercase;
        clip-path: polygon(0% 0%, 92% 15%, 92% 100%, 0% 85%);
        font-family: 'Modesto Text', sans-serif;
    }
    .container-blog{
        max-width: 1300px;
        width: 100%;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px 60px;
    }

    /* Card */
    .card-article{
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
        min-width: 0;
        background-color: rgb(243 241 238);
        padding: 20px;
        border-radius: 10px;
        text-decoration: none;
    }

    /* Imagen */
    .image-article{
        width: 100%;
        height: 200px;
    }

    .image-article img{
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Contenido */
    .content-article{
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
    }

    /* Títulos */
    .title-container-blog{
        font-size: 28px;
        font-weight: 400;
        font-family: 'Modesto Text', sans-serif;
        color: black;
        line-height: 35px;
        width: 1300px;
        border-top: solid 2px #d1d2d6;
        padding-top: 30px;
    }

    .title-article{
        font-size: 16px;
        font-weight: 400;
        font-family: 'Modesto Text', sans-serif;
        color: black;
        line-height: 30px;
        width: 100%;
    }

    /* Progress */
    .fundraising-article-content{
        display: flex;
        flex-direction: column;
        gap: 15px;
        width: 100%;
    }

    .progress{
        width: 80%;
        height: 12px;
        background: #d1d2d6;
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-bar{
        width: 50%;
        height: 100%;
        background: #69b183;
    }  
    .progress-text{
        font-size: 16px;
        font-weight: 400;
        font-family: 'Modesto Text', sans-serif;
        color: black;
        line-height: 30px;
        width: 100%;
    } 
    /* ── Tablet ── */
    @media (max-width: 1024px) {
        .main-container {
            margin-top: 70px;
            margin-bottom: 70px;
            gap: 35px;
            padding: 0 30px;
            box-sizing: border-box;
        }
        .container-title-blog {
            width: 100%;
        }
        .blog-title {
            font-size: 44px;
            width: 100%;
        }
        .blog-description {
            font-size: 22px;
            width: 100%;
            line-height: 30px;
        }
        .container-titles-blogs {
            grid-template-columns: repeat(2, 1fr);
            width: 100%;
            column-gap: 30px;
        }
        .title-container-blog {
            width: 100%;
            font-size: 22px;
        }
        .container-blog {
            grid-template-columns: repeat(2, 1fr);
            gap: 30px 30px;
            padding: 0 30px;
        }
    }

    /* ── Mobile ── */
    @media (max-width: 600px) {
        .main-container {
            margin-top: 50px;
            margin-bottom: 50px;
            gap: 24px;
            padding: 0 16px;
            box-sizing: border-box;
        }
        .container-title-blog {
            width: 100%;
            gap: 12px;
        }
        .blog-title {
            font-size: 32px;
            width: 100%;
        }
        .blog-description {
            font-size: 16px;
            width: 100%;
            line-height: 24px;
        }
        .container-titles-blogs {
            width: 100%;
            column-gap: 0;
            row-gap: 16px;
            grid-template-rows: auto auto;
            justify-items: center;
        }
        .title-blog {
            padding: 12px 30px;
            border-radius: 6px;
            text-align: center;
        }
        .title-container-blog {
            width: 100%;
            font-size: 20px;
            padding-top: 20px;
        }
        .container-blog {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 0 16px;
        }
        .image-article {
            height: 180px;
        }
        .title-article {
            font-size: 14px;
            line-height: 22px;
        }
        .progress-text {
            font-size: 14px;
        }
    }
</style>

{% schema %}
    {
    "name": "Fundraising",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Título Pagina"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Descripción Pagina"
        }
    ],
    "blocks": [
        {
        "type": "item",
        "name": "Item",
            "settings": [
                {
                    "type": "blog",
                    "id": "blog",
                    "label": "Blog"
                }
            ]
        }
    ],
    "max_blocks": 12,
    "presets": [
        {
        "name": "Fundraising"
        }
    ]
    }
{% endschema %}