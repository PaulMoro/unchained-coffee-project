<div class="main-container">
    <div class="container-title-blog">
        <h1 class="blog-title">{{ section.settings.title | upcase }}</h1>
        <div class="blog-description">{{ section.settings.description | upcase }}</div>
    </div>
    <div class="container-titles-blogs">
        {% for block in section.blocks %}
            <a href="{{ block.settings.blog.url }}" class="title-blog">{{ block.settings.blog.title | upcase }}</a>
        {% endfor %}
    </div>
    <div class="container-articles">
        {% for article in blog.articles %}
            <a 
                href="{{ article.url }}" 
                class="card-article"
                >
                <img src="{{ article.image | image_url: width: 800 }}" class="article-image" alt="{{ article.title }}">
                <div class="article-title">{{ article.title }}</div>
                <div class="article-author">{{ article.author }}</div>
                <div class="article-time-remaining">{{ article.metafields.custom.time_remaining }}</div>
                <div class="card-summary">{{ article.metafields.custom.card_summary }}</div>
                <div class="what-it-s-about">{{ article.metafields.custom.what_it_s_about }}</div>
            </a>
        {% endfor %}
    </div>
</div>

<style>
    .main-container{
        height: auto;
        width: 100vw;
        color: black;
        margin-top: 100px;
        margin-bottom: 100px;
        gap: 50px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        background: white;
        z-index: 2;
        position: relative;
    }
    .container-title-blog{
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
        width: 1300px;
    }
    .blog-title{
        font-size: 60px;
        font-weight: 400;
        color: black;
        text-align: center;
        margin: 0;
        width: 810px;
        text-align: left;
    }
    .blog-description{
        font-size: 28px;
        font-weight: 400;
        color: black;
        font-family: 'Modesto Text', sans-serif;
        color: rgb(179 176 176);
        width: 870px;
        text-align: left;
        width: 870px;
        line-height: 35px;
    }
    .container-titles-blogs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        column-gap: 60px;
        width: 1300px;
        row-gap: 40px;
    }

    @media (max-width: 1024px) {
        .container-titles-blogs {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .container-titles-blogs {
            grid-template-columns: 1fr;
        }
    }
    .title-blog{
        font-size: 16px;
        font-weight: 700;
        color: black;
        background-color: #FFD700;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        padding: 15px 60px;
        text-transform: uppercase;
        clip-path: polygon(0% 0%, 92% 15%, 92% 100%, 0% 85%);
        font-family: 'Modesto Text', sans-serif;
    }
    .container-articles{
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        width: 100%;
        padding-left: 200px;
        padding-right: 200px;
    }
    .card-article{
        width: 100%;
        height: 100%;
        color: white;
        padding: 10px;
        display: flex;
        gap: 10px;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        border-color: black;
        border-width: 1|px;
        border-style: solid;
    }
    .article-image{
        width: 100%;
        height: 100px;
    }
    .article-title{
        font-size: 20px;
        font-weight: 700;
        color: black;
    }
    .article-author{
        font-size: 16px;
        font-weight: 400;
        color: black;
    }
    .article-time-remaining{
        font-size: 16px;
        font-weight: 400;
        color: black;
    }
    .card-summary{
        font-size: 16px;
        font-weight: 400;
        color: black;
    }
    .what-it-s-about{
        font-size: 16px;
        font-weight: 400;
        color: black;
    }
</style>

{% schema %}
    {
    "name": "Fundraising",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Título Pagina"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Descripción Pagina"
        },
        {
            "type": "blog",
            "id": "blog1",
            "label": "Blog 1"
        },
        {
            "type": "blog",
            "id": "blog2",
            "label": "Blog 2"
        }
    ],
    "blocks": [
        {
        "type": "item",
        "name": "Item",
            "settings": [
                {
                    "type": "blog",
                    "id": "blog",
                    "label": "Blog"
                }
            ]
        }
    ],
    "max_blocks": 12,
    "presets": [
        {
        "name": "Fundraising"
        }
    ]
    }
{% endschema %}