<div class="main-container">
    <div class="container-title-blog">
        <h1 class="blog-title">{{ section.settings.title | upcase }}</h1>
        <div class="blog-description">{{ section.settings.description | upcase }}</div>
    </div>
    <div class="container-titles-blogs">
        {% for block in section.blocks %}
            <a href="{{ block.settings.blog.url }}" class="title-blog">{{ block.settings.blog.title | upcase }}</a>
        {% endfor %}
    </div>
    <div class="container-blog container-blog-1">
        <div class="title-container-blog">{{ section.settings.blog1.title  }}</div>
        {% for article in section.settings.blog1.articles %}
            <a class="card-article" href="{{ article.url }}">
                <div class="image-article">
                    <img src="{{ article.image | img_url: 'master' }}" alt="{{ article.title }}">
                </div>
                <div class="content-article">
                    <div class="title-article">{{ article.title }}</div>
                    <div class="fundraising-article-content">
                        <div class="progress">
                            <div class="progress-bar">&nbsp;</div>
                        </div>
                        
                        <div class="progress-text">$2,230 RAISED</div>
                    </div>
                </div>
            </a>
        {% endfor %}

    </div>
</div>

<style>
    .main-container{
        height: auto;
        width: 100vw;
        color: black;
        margin-top: 100px;
        margin-bottom: 100px;
        gap: 50px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        background: white;
        z-index: 2;
        position: relative;
    }
    .container-title-blog{
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
        width: 1300px;
    }
    .blog-title{
        font-size: 60px;
        font-weight: 400;
        color: black;
        text-align: center;
        margin: 0;
        width: 810px;
        text-align: left;
    }
    .blog-description{
        font-size: 28px;
        font-weight: 400;
        color: black;
        font-family: 'Modesto Text', sans-serif;
        color: rgb(179 176 176);
        width: 870px;
        text-align: left;
        width: 870px;
        line-height: 35px;
    }
    .container-titles-blogs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        column-gap: 60px;
        width: 1300px;
        row-gap: 40px;
    }

    @media (max-width: 1024px) {
        .container-titles-blogs {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .container-titles-blogs {
            grid-template-columns: 1fr;
        }
    }
    .title-blog{
        font-size: 16px;
        font-weight: 700;
        color: black;
        background-color: #FFD700;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        padding: 15px 60px;
        text-transform: uppercase;
        clip-path: polygon(0% 0%, 92% 15%, 92% 100%, 0% 85%);
        font-family: 'Modesto Text', sans-serif;
    }
    .container-blog{
        width: 1300px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        column-gap: 60px;
        row-gap: 40px;
    }
    .title-container-blog{
        font-size: 28px;
        font-weight: 400;
        color: black;
        font-family: 'Modesto Text', sans-serif;
        color: rgb(179 176 176);
        width: 870px;
        text-align: left;
        width: 870px;
        line-height: 35px;
    }
    .card-article{
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
    }
    .image-article{
        width: 100%;
        height: 200px;
    }
    .image-article img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .content-article{
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
    }
    .title-article{
        font-size: 28px;
        font-weight: 400;
        color: black;
        font-family: 'Modesto Text', sans-serif;
        color: rgb(179 176 176);
        width: 870px;
        text-align: left;
        width: 870px;
        line-height: 35px;
    }
    .fundraising-article-content{
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
    }
    .progress {
        width: 300px;          /* o 100% */
        height: 12px;
        background: #e5e7eb;   /* gris del track */
        border-radius: 999px;
        overflow: hidden;      /* para que respete bordes redondeados */
    }

    .progress-bar {
        width: 50%;            /* <- 50% de progreso */
        height: 100%;
        background: #22c55e;   /* color de la barra */
    }
</style>

{% schema %}
    {
    "name": "Fundraising",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Título Pagina"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Descripción Pagina"
        },
        {
            "type": "blog",
            "id": "blog1",
            "label": "Blog 1"
        },
        {
            "type": "blog",
            "id": "blog2",
            "label": "Blog 2"
        }
    ],
    "blocks": [
        {
        "type": "item",
        "name": "Item",
            "settings": [
                {
                    "type": "blog",
                    "id": "blog",
                    "label": "Blog"
                }
            ]
        }
    ],
    "max_blocks": 12,
    "presets": [
        {
        "name": "Fundraising"
        }
    ]
    }
{% endschema %}